<Project Sdk="Microsoft.NET.Sdk.Web">
    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <UserSecretsId>09022fac-ef2e-4453-8d16-926f18bff5b5</UserSecretsId>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    </PropertyGroup>
    <ItemGroup>
        <None Remove="logs\log.txt" />
        <Content Include="logs\log.txt">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="6.0.26" />
        <PackageReference Include="Microsoft.AspNetCore.Mvc.NewtonsoftJson" Version="6.0.7" />
        <PackageReference Include="Microsoft.Bot.Builder" Version="4.22.0" />
        <PackageReference Include="Microsoft.Bot.Builder.Integration.AspNet.Core" Version="4.22.0" />
        <PackageReference Include="Microsoft.Bot.Configuration" Version="4.22.0" />
        <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.19.6" />
        <PackageReference Include="SonarAnalyzer.CSharp" Version="7.14.0.8411">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Telegram.Bot" Version="17.0.0" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\Fanex.BotService.Core\Fanex.BotService.Core.csproj" />
        <ProjectReference Include="..\Fanex.BotService.Resources\Fanex.BotService.Resources.csproj" />
    </ItemGroup>
    <ItemGroup>
        <Content Update="appsettings.PROD_1.json">
          <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
        <Content Update="appsettings.UAT.json">
          <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
        <Content Update="appsettings.PROD.json">
          <CopyToOutputDirectory>Always</CopyToOutputDirectory>
          <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
          <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        </Content>
        <Content Update="appsettings.SIT.json">
          <CopyToOutputDirectory>Always</CopyToOutputDirectory>
          <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
          <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        </Content>
        <Content Update="appsettings.LOCAL.json">
          <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
        <Content Update="appsettings.json">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
    </ItemGroup>
    <ItemGroup>
        <None Update="App_Data\SpNames.xml">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
    </ItemGroup>
    <ItemGroup>
        <Compile Remove="Program.cs" />
        <Compile Include="Program.cs">
            <SonarQubeExclude>true</SonarQubeExclude>
        </Compile>
    </ItemGroup>
    <ItemGroup>
        <Compile Remove="BotServiceDI.cs" />
        <Compile Include="BotServiceDI.cs">
            <SonarQubeExclude>true</SonarQubeExclude>
        </Compile>
    </ItemGroup>
</Project>